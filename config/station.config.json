{
  "station": {
    "name": "梦可电台",
    "host": "梦可",
    "port": 9730
  },
  "engine": {
    "voiceEnabled": true,
    "talkIntervalMs": [300000, 480000],
    "minTalkGapMs": 90000,
    "preferReplyMs": 0,
    "forceReplyMs": 20000,
    "topicCooldownMs": 2400000,
    "topicChance": 0.15,
    "pendingTimeoutMs": 120000,
    "produceBudgetMs": 45000,
    "nodeWindow": {
      "minIntoTrackMs": 20000,
      "minBeforeTrackEndMs": 10000
    }
  },
  "scheduler": {
    "noRepeatWindowMs": 1800000,
    "styleBaseWeights": {},
    "timeOfDayBoost": {},
    "recencyPenaltyHalfLifePlays": 8
  },
  "audio": {
    "ducking": {
      "speechGain": 0.45,
      "attackTauMs": 250,
      "releaseDelayMs": 1200,
      "releaseTauMs": 600
    },
    "crossfadeMs": 250,
    "speechVolume": 1
  },
  "llm": {
    "provider": "ark",
    "baseUrl": "https://ark.cn-beijing.volces.com/api/v3",
    "model": "doubao-seed-2-1-pro-260628",
    "apiKeyEnv": "ARK_API_KEY",
    "temperature": 0.8,
    "webSearch": true,
    "timeoutMs": 60000,
    "maxTokens": 2500,
    "maxSegmentChars": 180,
    "maxSegmentCharsByKind": {
      "station_id": 40,
      "interlude": 120,
      "topic": 400,
      "reply": 180,
      "request_ack": 80
    }
  },
  "tts": {
    "provider": "minimax",
    "postProcess": "loudnorm",
    "cacheDir": ".cache/tts",
    "speechRate": 0.9,
    "edge": {
      "voice": "zh-CN-XiaoxuanNeural"
    },
    "minimax": {
      "voice": "Chinese_wenrounvxing",
      "model": "speech-2.8-hd",
      "vol": 1,
      "apiKeyEnv": "MINIMAX_API_KEY",
      "groupIdEnv": "MINIMAX_GROUP_ID"
    }
  },
  "messages": {
    "retentionDays": 7
  },
  "library": {
    "root": "config/library"
  },
  "memory": {
    "retrievalLimit": 3,
    "decayHalfLifeDays": 7,
    "recencyBoostHalfLifeDays": 0.5,
    "minScore": 0.45
  }
}
