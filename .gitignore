# deps & build
node_modules/
dist/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example

# IDE
.idea/

# runtime data & caches
data/
.cache/

# AI 工具本地资产：技能文件、代码图谱索引、本地 issue 草稿不入库
.agents/
.codegraph/
.scratch/
.tmp/

# 曲库音频：目录结构进 git，音频文件不进（任意嵌套）
config/library/**/*.mp3
config/library/**/*.flac
config/library/**/*.ogg
config/library/**/*.m4a
config/library/**/*.wav
config/library/**/*.opus
config/library/**/*.aac
!config/library/**/.gitkeep

# 本地 git worktree
.worktrees/

# 本地 FFmpeg 二进制：体积大，不入库
# 缺失时自动回退系统 PATH 上的 ffmpeg/ffprobe
tools/ffmpeg/*.exe

# 产品文档与协作规范：个人资产，不入库
docs/

# OS
.DS_Store
Thumbs.db
